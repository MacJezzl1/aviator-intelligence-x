# ==============================================================================
# AVIATOR INTELLIGENCE X (AIX) — ENVIRONMENT CONFIGURATION (v3.0)
# ==============================================================================
# Master Specification: v3.0 (Truth-Locked Edition — Web-First, Real-Results)
# Rule T8: Secrets never reach the client. Service-role keys, provider API keys,
# and database credentials live only in server-side environment configuration.
# Only publishable (NEXT_PUBLIC_) keys may exist in browser code.
# Rule T14: Website-first. The responsive website and installable PWA are the
# only product surfaces. Outbound chat relays are strictly optional.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE CLIENT KEYS (Safe for Client / Browser Code)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://rrhtenamwselyjufyntw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.e30.placeholder_anon_key

# ------------------------------------------------------------------------------
# 2. SUPABASE SERVICE ROLE KEY (STRICTLY SERVER-SIDE ONLY — NEVER EXPOSE TO CLIENT)
# ------------------------------------------------------------------------------
# Required for background tasks, schema migrations, and privileged system audits.
SUPABASE_SERVICE_ROLE_KEY=placeholder_service_role_key

# ------------------------------------------------------------------------------
# 3. OWNER BOOTSTRAP (STRICTLY SERVER-SIDE ONLY — v2.0 Section 11.1)
# ------------------------------------------------------------------------------
# Single-use bootstrap token. The first registration presenting this token
# becomes OWNER. After consumption, the token is permanently invalidated.
AIX_OWNER_EMAIL=owner@aix-terminal.io
OWNER_BOOTSTRAP_TOKEN=aix_super_secret_bootstrap_token_2026
AIX_BOOTSTRAP_SECRET=aix_super_secret_bootstrap_token_2026

# ------------------------------------------------------------------------------
# 4. AI MODEL PROVIDER API KEYS (SERVER-SIDE ONLY — Appendix A)
# ------------------------------------------------------------------------------
# Free tiers and local models are prioritized. The system operates in L3
# (code-only mode) with all 59 deterministic agents operational if keys are blank.
OLLAMA_BASE_URL=http://localhost:11434
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=

# ------------------------------------------------------------------------------
# 5. SECURITY & SESSION CONFIGURATION (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
NEXTAUTH_SECRET=aix_production_session_signing_secret_9942048201
NODE_ENV=development

# ------------------------------------------------------------------------------
# 6. OPTIONAL OUTBOUND RELAY (SERVER-SIDE ONLY — Section 13, Rule T14)
# ------------------------------------------------------------------------------
# Outbound notification relay for owner's personal notifications only.
# Off by default. The website remains the only primary interface.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
